{
  "name": "ai-personality-explorer-tencent-scf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:web": "vite",
    "dev:api": ".venv\\Scripts\\python.exe -X utf8 -m backend",
